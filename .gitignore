# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# PyInstaller build artifacts
dist/
build/

# sde_base.db IS tracked in git (uploaded to GitHub Releases for first-run setup)
# !sde_base.db  ← override needed because *.db is ignored above

# Databases and sensitive data (sde_base.db is an exception — tracked in git)
*.db
*.db-shm
*.db-wal
!sde_base.db
data/tokens.json

# EVE SDE data (large files, downloaded separately)
data/sde.zip
# Downloaded SDE archives (~95 MB each), kept so a re-import needs no network
data/sde-archives/
data/fsd/
data/fsd_backup/

# Android / Gradle (build/ above already covers android-poc/app/build/)
.gradle/
android-poc/local.properties
android-poc/.gradle/
# build-time copies (generated by prepare.sh from the repo root — not source)
android-poc/app/src/main/python/app/
android-poc/app/src/main/assets/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Private agent/Claude context (symlinks to the eve-retroindustry-notes repo) — never in public
/CLAUDE.md
/AGENTS.md

# Local type-icon cache (populated at runtime from images.evetech.net)
icon_cache/

# Local reference material (third-party spreadsheets — see docs/design-hosted-v2.md 9.2/9.3)
docs/reference/

# Deployment configuration. .env.example is the committed template; a real .env
# names your EVE application and belongs on the server, not in the repo.
.env
.env.*
!.env.example
