# EVE Retroindustry — deployment configuration.
#
# Copy to /etc/eve-retroindustry.env on the server, fill in the blanks, and point
# the systemd unit at it with EnvironmentFile=. Root-owned, mode 0600 — it names
# your EVE application, though no secret lives here (the flow is PKCE).
#
# Nothing in this file is needed for local development: every value below has a
# working localhost default. See docs/deploy-vps.md for the full walkthrough.


# --- Identity of this deployment ---------------------------------------------

# Hostnames the app will answer on, comma-separated, no scheme and no port.
# The Host header is checked against this list, which is what stops DNS
# rebinding — so no wildcards, and it must match what nginx passes through
# (proxy_set_header Host $host).
EVE_ALLOWED_HOSTS=industry.example.com

# Where EVE sends the browser back. Must match the callback URL registered at
# https://developers.eveonline.com/ *exactly* — scheme, host and path.
EVE_CALLBACK_URL=https://industry.example.com/callback

# The EVE application this deployment authenticates as.
#
# Required whenever the callback is not on localhost. An application has exactly
# one registered callback URL, so the client ID and the callback are two halves
# of one registration and a deployment cannot borrow another's. Register your
# own application (Authentication & API Access, full scope list) and put its
# client ID here. There is no client secret.
EVE_CLIENT_ID=


# --- Security ----------------------------------------------------------------

# Mark session cookies Secure. Set this only once TLS is actually terminating —
# with it on, a browser will not send the cookie over plain HTTP and you will
# not be able to log in.
EVE_COOKIE_SECURE=1

# The character that owns this instance.
#
# Leave empty and the first character to complete SSO claims it, which is fine
# on a laptop and is a real window on a public box between deploying and logging
# in. Fill it in with your own character id after first login and restart. The
# log prints the id when a claim happens.
EVE_OWNER_CHARACTER_ID=


# --- Storage -----------------------------------------------------------------

# Writable directory for the database, config and caches. The app restricts
# eve_cache.db to 0600 itself; it holds every character's refresh token.
EVE_APP_DIR=/opt/eve-retroindustry


# --- Debugging ---------------------------------------------------------------

# Uncomment to put exception tracebacks back into HTTP responses. Off in
# production: the response body goes to whoever made the request, and these
# carry absolute paths, SQL and local variable values. The server log keeps the
# full detail either way.
#EVE_DEBUG_ERRORS=1
